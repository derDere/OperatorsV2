# Lokale Host-/Umgebungswerte -- `make start` kopiert diese Datei nach .env,
# eine vorhandene .env bleibt unangetastet.
COMPOSE_PROJECT_NAME=operatorsv2

# Auf dem Host veroeffentlichter Port des Webservers.
APP_PORT=5500

# Eingangstuer fuer `make open` (127.0.0.1 statt localhost umgeht den Firmen-Webfilter).
APP_URL=http://127.0.0.1:5500
